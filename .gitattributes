# 统一换行：仓库内一律 LF，检出时按平台转换
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf

# 二进制：不要做任何转换
*.png binary
*.ico binary
*.dll binary
*.exe binary
